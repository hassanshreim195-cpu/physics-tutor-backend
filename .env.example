# Copy to .env for local development. On Render, set these in the Environment tab.

GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

DATABASE_URL=postgresql://user:password@host:5432/dbname

# REQUIRED — the server refuses to start without this, and it must be at least
# 32 characters. Generate a real one (do not make one up by hand):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste-a-64-plus-character-random-hex-string-here

# The email of the account that should have teacher/admin access. The matching
# account is promoted to role='teacher' automatically — at startup if it already
# exists, otherwise the first time that account makes a request.
ADMIN_EMAIL=your-own-email-you-registered-with

# --- Optional (sensible defaults if unset) ---
# Max AI calls one account may make per day. Default 120.
# AI_DAILY_LIMIT=120
# How long to wait on Groq/Gemini before giving up, in ms. Default 45000.
# AI_TIMEOUT_MS=45000
# Extra allowed frontend origins, comma-separated (e.g. a custom domain).
# ALLOWED_ORIGINS=https://your-domain.com
